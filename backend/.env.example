# =====================================================
# NutriMind Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =====================================================

# ── Server ────────────────────────────────────────
PORT=5000

# ── MongoDB (owned by Collaborator 3 / Backend-1) ─
MONGO_URI=mongodb://localhost:27017/nutrimind

# ── JWT (owned by Collaborator 3 / Backend-1) ─────
JWT_SECRET=your_jwt_secret_here

# ── Google Gemini AI (owned by Collaborator 4) ────
# Obtain from https://aistudio.google.com/app/apikey
# Keep this key ONLY on the server — never expose it to the React frontend.
GEMINI_API_KEY=

# ── CORS ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
